# Copy this file to .streamlit/secrets.toml for local development, and paste the
# same [google_oauth] block into the "Secrets" editor in the Streamlit Community
# Cloud dashboard for deployment.
#
# Values come from a Google Cloud OAuth client of type "Web application"
# (see README.md → Google Cloud setup). The redirect_uri MUST exactly match one of
# the client's "Authorized redirect URIs".

[google_oauth]
client_id = "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET"
# Local dev:
redirect_uri = "http://localhost:8501"
# When deployed, set this to your app URL instead, e.g.:
# redirect_uri = "https://your-app-name.streamlit.app"
